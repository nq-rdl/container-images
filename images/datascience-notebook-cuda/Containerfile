# syntax=docker/dockerfile:1.7

# UBI9-rooted SciPy notebook; retain the existing CUDA image name for consumers.
ARG BASE_CONTAINER=ghcr.io/nq-rdl/scipy-notebook-ubi9:2026.6.0@sha256:5d7ed4885cdf9af075340af5e035753a333d5d69e358e0e226b555c8ccbb981a
# Hadolint cannot resolve this ARG; chained-base policy checks enforce its default pin.
# hadolint ignore=DL3026
FROM ${BASE_CONTAINER}

LABEL org.opencontainers.image.title="datascience-notebook-cuda"
LABEL org.opencontainers.image.description="Jupyter SciPy notebook on UBI9 + CUDA 12.6 runtime + cuDNN + pytorch-gpu (conda-forge)."
LABEL org.opencontainers.image.source="https://github.com/nq-rdl/container-images"
LABEL org.opencontainers.image.vendor="Research Data Laboratory"
LABEL org.opencontainers.image.licenses="MIT"

USER ${NB_UID}

# Cumulative manifest preserves the SciPy stack in the inherited notebook environment.
# No driver is installed: the host supplies it through CDI. The override is confined
# to installation on builders without a GPU; runtime device detection stays real.
COPY --chown=${NB_UID}:${NB_GID} pixi.toml pixi.lock /opt/nb/
COPY smoke-test.py /usr/local/bin/cuda-smoke-test.py
RUN CONDA_OVERRIDE_CUDA=12.6 pixi install --locked --manifest-path /opt/nb/pixi.toml \
    && python /usr/local/bin/cuda-smoke-test.py \
    && rm -rf /tmp/pixi-cache \
    && fix-permissions "${NB_PIXI_PROJECT}" \
    && fix-permissions "/home/${NB_USER}"

WORKDIR "${HOME}"
