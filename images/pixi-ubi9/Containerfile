# syntax=docker/dockerfile:1.7

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:984df0a2b8d9011d419b0ad260b25f6b74b7ce69ab0595b75522e30f8849f27f

ARG PIXI_VERSION=0.74.0
ARG TARGETARCH

LABEL org.opencontainers.image.title="pixi-ubi9" \
    org.opencontainers.image.description="Pixi ${PIXI_VERSION} on UBI9 minimal" \
    org.opencontainers.image.source="https://github.com/nq-rdl/container-images" \
    org.opencontainers.image.vendor="Research Data Laboratory" \
    org.opencontainers.image.licenses="MIT"

RUN microdnf install -y --nodocs tar gzip ca-certificates \
    && microdnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf

# Pin both architecture checksums alongside PIXI_VERSION.
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) PIXI_ARCH=x86_64; PIXI_SHA256=5729e99fb569a25f0b65dd6f5d1f32fcf3b967b36c1e89b9bab6a3bf845cc655 ;; \
        arm64) PIXI_ARCH=aarch64; PIXI_SHA256=86b9eaace45f28e2fa599e5cb1ca7b123cb3db6c7a9175cda6cb139815724d75 ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/pixi.tar.gz \
        "https://github.com/prefix-dev/pixi/releases/download/v${PIXI_VERSION}/pixi-${PIXI_ARCH}-unknown-linux-musl.tar.gz"; \
    echo "${PIXI_SHA256}  /tmp/pixi.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/pixi.tar.gz -C /usr/local/bin pixi; \
    chmod 755 /usr/local/bin/pixi; \
    rm /tmp/pixi.tar.gz; \
    pixi --version

ENV HOME=/home/pixi \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
RUN mkdir -p /home/pixi /workspace \
    && chown -R 1001:0 /home/pixi /workspace \
    && chmod -R g=u /home/pixi /workspace
USER 1001:0
WORKDIR /workspace
CMD ["pixi", "--help"]
